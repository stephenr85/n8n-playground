      "parameters": {
        "jsCode": "const searchResponse = $input.first().json;\nconst results = searchResponse.data?.results || [];\n\n// Get the question from earlier in the chain\nconst question = \"What are the eligibility requirements for an SBA 7(a) loan?\";\n\nconst context = results.map((r, i) => {\n  const name = r.fragment?.name || \"Unknown\";\n  const text = (r.fragment?.text || \"\").substring(0, 2000);\n  const score = r.rrf_score || 0;\n  return `--- Source ${i+1}: ${name} (score: ${score.toFixed(4)}) ---\\n${text}`;\n}).join(\"\\n\\n\");\n\nreturn [{ json: { question, context, source_count: results.length } }];"
      },
